---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const sections = [
  {
    title: 'Qué pasa hoy con tus datos',
    body: 'Este sitio es informativo. El formulario de contacto todavía no envía ni almacena información: lo que escribas en él no sale de tu navegador. Tampoco incluye herramientas de analítica ni cookies de seguimiento.',
  },
  {
    title: 'Cuando habilitemos un canal de contacto',
    body: 'Antes de recibir cualquier dato personal actualizaremos este aviso para decirte quién es el responsable, qué datos pedimos, para qué los usamos, con quién se comparten y cómo puedes acceder a ellos, corregirlos, cancelarlos u oponerte a su uso.',
  },
  {
    title: 'Cambios a este aviso',
    body: 'Publicaremos cualquier cambio en esta misma página y actualizaremos la fecha de arriba.',
  },
];
---
<BaseLayout title="Aviso de privacidad | ichkin" description="Cómo trata ichkin tus datos en este sitio.">
  <main class="bg-marfil text-carbon">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16">
      <Header />

      <article class="max-w-2xl pb-24 pt-14 sm:pt-20">
        <h1 class="font-display text-balance text-5xl font-semibold leading-[1.05] sm:text-6xl">Aviso de privacidad</h1>
        <p class="mt-4 text-sm leading-6 text-pizarra">Última actualización: 18 de noviembre de 2026.</p>
        <p class="mt-6 rounded-md border border-trazo p-4 text-base leading-6 text-carbon">Borrador provisional. Este texto describe el estado actual del sitio y aún necesita revisión legal antes de recopilar datos personales.</p>

        {sections.map((s) => (
          <section class="mt-12 border-t border-linea pt-6">
            <h2 class="font-display text-2xl font-medium leading-8">{s.title}</h2>
            <p class="mt-3 text-base leading-7 text-pizarra">{s.body}</p>
          </section>
        ))}
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>
