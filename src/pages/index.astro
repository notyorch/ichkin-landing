---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  { key: 'Web', items: 'Websites · Interfaces · Portfolios', copy: 'Una presencia que explica tu valor, orienta decisiones y abre conversaciones útiles.', story: 'Alguien en una cafetería revisa tu portafolio y decide contratarte.' },
  { key: 'Sistemas', items: 'ERP · CRM · CMS · ITSM · BPM', copy: 'Procesos y herramientas que dejan de vivir en archivos sueltos, chats y memoria.', story: 'Un equipo lleva la contabilidad en el mismo ERP, al mismo tiempo.' },
  { key: 'Datos', items: 'ETL · Data warehouse · Analytics', copy: 'Información que llega completa, se entiende y se puede convertir en una decisión.', story: 'La dirección ve en un panel hacia dónde mover la empresa.' },
  { key: 'Inteligencia', items: 'RAG · Agentes de IA · Capacitación', copy: 'IA construida alrededor de tu contexto, documentos y reglas de trabajo.', story: 'Un agente atiende al cliente y resuelve dudas del equipo.' },
  { key: 'Automatización', items: 'Webhooks · Serverless · Workflows', copy: 'Conexiones que quitan pasos repetitivos sin volver opaco el proceso.', story: 'A las 7:00, el reporte de la semana llega solo al celular.' },
  { key: 'Colaboración', items: 'Nextcloud · Mattermost · Plane · Penpot', copy: 'Un espacio compartido para que las personas, el conocimiento y el avance sigan cerca.', story: 'Un equipo de diseño edita el mismo lienzo a la vez.' },
];

const shifts = [
  ['Archivos sueltos', 'Un sistema que organiza'],
  ['Chats y memoria', 'Un espacio compartido'],
  ['Pasos repetitivos', 'Una automatización que los quita'],
];

const steps = [
  ['Escuchar el contexto', 'Personas, procesos, información y restricciones que ya están en juego.'],
  ['Trazar las conexiones', 'Qué se debe integrar, qué se debe simplificar y qué no hace falta construir.'],
  ['Definir el siguiente paso', 'Una decisión concreta que puedas evaluar antes de comprometer más recursos.'],
];

const pad = (n: number) => String(n + 1).padStart(2, '0');
---
<BaseLayout title="ichkin | Consultoría tecnológica" description="Conectamos sistemas, datos, procesos y personas para que tu operación trabaje junta.">
  <main class="bg-marfil text-carbon">
    <section id="inicio" class="relative overflow-hidden">
      <div class="glyph" aria-hidden="true">k</div>
      <div class="relative mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16">
        <header class="flex h-[72px] items-center justify-between gap-5 border-b border-linea" aria-label="Navegación principal">
          <a href="#inicio" aria-label="ichkin, inicio" class="block">
            <img src="/brand/ichkin-wordmark.svg" alt="ichkin" class="block h-6 w-auto" width="87" height="24" />
          </a>
          <nav class="flex items-center gap-3" aria-label="Secciones">
            <a class="hidden px-3 text-sm font-medium text-pizarra transition-colors hover:text-carbon sm:block" href="#capacidades">Capacidades</a>
            <a class="hidden px-3 text-sm font-medium text-pizarra transition-colors hover:text-carbon sm:block" href="#metodo">Método</a>
            <a class="btn btn--secondary btn--sm" href="#diagnostico">Solicitar diagnóstico</a>
          </nav>
        </header>

        <div class="flex flex-col justify-center gap-14 pb-16 pt-14 sm:pt-20 lg:min-h-[calc(100vh-72px)] lg:gap-20">
          <div>
            <h1 class="font-display rise max-w-[15ch] text-balance text-5xl font-semibold leading-[1.02] text-carbon sm:text-7xl lg:text-[6rem]" style="--i:0">Convierte tecnología dispersa en trabajo conectado.</h1>
            <p class="rise mt-7 max-w-[440px] text-base leading-6 text-pizarra sm:text-lg sm:leading-7" style="--i:1">ichkin conecta los sistemas, datos y herramientas que ya usas para que tu operación deje de perder contexto entre pasos.</p>
            <div class="rise mt-8 flex flex-wrap items-center gap-3" style="--i:2">
              <a class="btn btn--primary" href="#diagnostico"><i aria-hidden="true"></i>Solicitar un diagnóstico</a>
              <a class="btn btn--secondary" href="#capacidades">Ver capacidades</a>
            </div>
          </div>

          <ul class="max-w-[820px] border-t border-linea" aria-label="Qué cambia con ichkin">
            {shifts.map(([from, to], i) => (
              <li class="rise grid items-baseline gap-x-6 gap-y-1 border-b border-linea py-4 sm:grid-cols-[minmax(10rem,0.8fr)_1.5rem_1.4fr]" style={`--i:${i + 3}`}>
                <span class="text-base leading-6 text-pizarra">{from}</span>
                <svg class="hidden h-4 w-6 self-center text-petroleo sm:block" viewBox="0 0 24 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h19M15 2l6 6-6 6" /></svg>
                <span class="font-display text-2xl font-medium leading-[30px]">{to}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="on-dark bg-carbon px-6 py-20 sm:px-10 lg:px-16 lg:py-28">
      <div class="mx-auto max-w-[1440px]">
        <p class="font-display max-w-5xl text-balance text-4xl font-semibold leading-[1.05] text-marfil sm:text-6xl">La solución no empieza por comprar otra plataforma. Empieza por entender qué necesita conectarse.</p>
      </div>
    </section>

    <section id="capacidades-section" class="px-6 py-20 sm:px-10 lg:px-16 lg:py-28">
      <div class="mx-auto grid max-w-[1440px] gap-x-16 gap-y-8 lg:grid-cols-[1.15fr_0.85fr]">
        <div class="contents lg:block">
          <div>
            <h2 class="font-display max-w-xl text-4xl font-semibold leading-[1.05] sm:text-5xl">Una consultoría que mira la operación completa.</h2>
            <p class="mt-6 max-w-[440px] text-base leading-6 text-pizarra sm:text-lg sm:leading-7">La capa visible, el sistema que organiza, los datos que explican y las automatizaciones que mantienen el flujo.</p>
          </div>
          <div data-scene class="scene-wrap sticky top-16 z-10 h-[40vh] min-h-[250px] overflow-hidden rounded-lg border border-linea-oscura bg-[#15181e] lg:top-24 lg:mt-10 lg:aspect-[5/4] lg:h-auto lg:max-h-[calc(100vh-8rem)] lg:w-full">
            <canvas data-scene-canvas class="block h-full w-full" aria-hidden="true"></canvas>
          </div>
        </div>
        <ol id="capacidades" class="border-t border-linea" data-scene-list>
          {services.map((service, i) => (
            <li class="flex min-h-[78vh] flex-col justify-start gap-3 border-b border-linea pb-10 pt-[calc(40vh+5rem)] lg:min-h-[80vh] lg:justify-center lg:py-10">
              <span class="eyebrow text-pizarra">{pad(i)}</span>
              <h3 class="font-display text-3xl font-medium leading-9 sm:text-4xl sm:leading-[44px]">{service.key}</h3>
              <p class="text-sm font-medium leading-6 text-petroleo">{service.items}</p>
              <p class="mt-1 max-w-md text-base leading-6 text-pizarra">{service.copy}</p>
              <p class="max-w-md border-t border-linea pt-3 text-base leading-6 text-carbon">{service.story}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="metodo" class="border-t border-linea px-6 py-20 sm:px-10 lg:px-16 lg:py-28">
      <div class="mx-auto max-w-[1440px]">
        <div class="grid gap-8 pb-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
          <div>
            <h2 class="font-display max-w-xl text-4xl font-semibold leading-[1.05] sm:text-5xl">Antes de implementar, trazamos el mapa.</h2>
          </div>
          <p class="max-w-xl text-base leading-6 text-pizarra sm:text-lg sm:leading-7">El diagnóstico sirve para mirar la operación completa antes de escoger una plataforma, una automatización o una implementación de IA.</p>
        </div>
        <ol class="grid border-t border-linea lg:grid-cols-3">
          {steps.map(([title, copy], i) => (
            <li class="border-b border-linea py-8 lg:border-b-0 lg:border-l lg:px-8 lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0">
              <span class="eyebrow text-pizarra">{pad(i)}</span>
              <h3 class="font-display mt-3 text-2xl font-medium leading-[30px]">{title}</h3>
              <p class="mt-3 max-w-sm text-base leading-6 text-pizarra">{copy}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="diagnostico" class="on-dark bg-carbon px-6 py-20 sm:px-10 lg:px-16 lg:py-28">
      <div class="mx-auto grid max-w-[1440px] gap-12 lg:grid-cols-[1fr_0.8fr] lg:items-end">
        <div>
          <h2 class="font-display max-w-3xl text-5xl font-semibold leading-[1.02] text-marfil sm:text-6xl">Empecemos por el problema que tienes enfrente.</h2>
          <p class="mt-6 max-w-[440px] text-base leading-6 text-gris-tecnico sm:text-lg sm:leading-7">Cuéntanos qué parte de tu operación quieres hacer más clara, más conectada o más útil. A partir de ahí definimos la conversación correcta.</p>
        </div>
        <form class="grid gap-5 rounded-lg border border-linea-oscura bg-grafito/40 p-6 sm:p-8" aria-describedby="form-note">
          <label class="grid gap-2 text-sm font-medium text-marfil">Tu nombre<input class="field" name="name" autocomplete="name" placeholder="Cómo te llamas" /></label>
          <label class="grid gap-2 text-sm font-medium text-marfil">Tu correo<input class="field" type="email" name="email" autocomplete="email" placeholder="tu@empresa.com" /></label>
          <label class="grid gap-2 text-sm font-medium text-marfil">¿Qué quieres resolver?<textarea class="field min-h-28 resize-y" name="context" placeholder="El contexto, el problema o la oportunidad."></textarea></label>
          <button class="btn btn--primary w-fit cursor-not-allowed opacity-60" type="button" aria-disabled="true"><i aria-hidden="true"></i>Canal de contacto pendiente</button>
          <p id="form-note" class="text-sm leading-6 text-gris-tecnico">Este formulario es parte del esqueleto visual. Aún no envía ni almacena información.</p>
        </form>
      </div>
    </section>

    <footer class="on-dark border-t border-linea-oscura bg-carbon px-6 py-8 sm:px-10 lg:px-16">
      <div class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-4">
        <img src="/brand/ichkin-wordmark-inverso.svg" alt="ichkin" class="block h-5 w-auto" width="72" height="20" />
        <p class="text-xs leading-4 text-gris-tecnico">Tecnología alrededor de las personas.</p>
      </div>
    </footer>
  </main>
</BaseLayout>

<script>
  // El motor 3D pesa: solo se descarga cuando la sección está por aparecer.
  const section = document.querySelector('#capacidades-section');
  const wrap = document.querySelector<HTMLElement>('[data-scene]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-scene-canvas]');
  const list = document.querySelector('[data-scene-list]');
  if (section && wrap && canvas && list) {
    const io = new IntersectionObserver(
      async (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        try {
          const { start } = await import('../scripts/scene/index.js');
          list.classList.add('js-scenes');
          await start({ wrap, canvas, items: [...list.children] });
        } catch (err) {
          console.error(err);
          wrap.dataset.state = 'fallback';
          list.classList.remove('js-scenes');
        }
      },
      { rootMargin: '700px 0px' },
    );
    io.observe(section);
  }
</script>
