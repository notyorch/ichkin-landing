---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { steps } from '../data/services.js';

const hacemos = [
  'Implementamos ERP, CRM, procesos y herramientas de equipo de código abierto.',
  'Las conectamos con los sistemas y herramientas que ya usas.',
  'Ordenamos tus datos, construimos tableros y ponemos IA a trabajar con tus documentos.',
  'Automatizamos pasos repetitivos y capacitamos a tu equipo para usar lo nuevo.',
];
const noHacemos = [
  'No vendemos un software propio de marca al que tengas que entrar.',
  'No te atamos a licencias caras ni a un sistema cerrado.',
  'No desarrollamos a medida como regla: solo cuando hace falta.',
];
const principios = [
  ['Entender antes de construir', 'El diagnóstico va primero. A veces la respuesta es no construir nada.'],
  ['Hablas con quien construye', 'Sin intermediarios ni cuentas comerciales de por medio.'],
  ['Claridad sobre promesa', 'Decimos qué hacemos y cómo lo hacemos. Sin inflar.'],
  ['Lo que existe se conecta primero', 'Partimos de lo que tu equipo ya usa antes de reemplazar nada.'],
];
---
<BaseLayout title="Nosotros | ichkin" description="ichkin es una consultoría tecnológica sin intermediarios: implementamos y conectamos herramientas de código abierto.">
  <main class="bg-marfil text-carbon">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16">
      <Header current="nosotros" />

      <section class="pb-16 pt-14 sm:pt-20 lg:pb-24">
        <h1 class="font-display max-w-[16ch] text-balance text-5xl font-semibold leading-[1.06] sm:text-7xl">Hablas con quien construye la solución.</h1>
        <p class="mt-6 max-w-[34rem] text-base leading-6 text-pizarra sm:text-lg sm:leading-7">ichkin es una consultoría tecnológica sin intermediarios. Implementamos herramientas de código abierto y las conectamos con lo que tu equipo ya usa, para que la operación deje de perder contexto entre pasos.</p>
      </section>

      <section class="grid gap-10 border-t border-linea py-12 lg:grid-cols-2 lg:gap-16 lg:py-16">
        <div>
          <h2 class="font-display text-3xl font-semibold leading-9 sm:text-4xl">Qué hacemos</h2>
          <ul class="mt-6 border-t border-linea">
            {hacemos.map((t) => <li class="border-b border-linea py-4 text-base leading-6">{t}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="font-display text-3xl font-semibold leading-9 sm:text-4xl">Qué no hacemos</h2>
          <ul class="mt-6 border-t border-linea">
            {noHacemos.map((t) => <li class="border-b border-linea py-4 text-base leading-6 text-pizarra">{t}</li>)}
          </ul>
        </div>
      </section>

      <section class="border-t border-linea py-12 lg:py-16">
        <h2 class="font-display max-w-xl text-3xl font-semibold leading-9 sm:text-4xl">Cómo trabajamos</h2>
        <ol class="mt-8 grid border-t border-linea lg:grid-cols-3">
          {steps.map(([title, copy], i) => (
            <li class="border-b border-linea py-8 lg:border-b-0 lg:border-l lg:px-8 lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0">
              <span class="eyebrow text-pizarra">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="font-display mt-3 text-2xl font-medium leading-[30px]">{title}</h3>
              <p class="mt-3 max-w-sm text-base leading-6 text-pizarra">{copy}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="border-t border-linea py-12 pb-20 lg:py-16 lg:pb-28">
        <h2 class="font-display max-w-xl text-3xl font-semibold leading-9 sm:text-4xl">Cómo pensamos</h2>
        <dl class="mt-8 grid gap-x-16 border-t border-linea sm:grid-cols-2">
          {principios.map(([title, copy]) => (
            <div class="border-b border-linea py-6">
              <dt class="font-display text-2xl font-medium leading-[30px]">{title}</dt>
              <dd class="mt-2 max-w-sm text-base leading-6 text-pizarra">{copy}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>

    <section class="on-dark bg-carbon px-6 py-20 sm:px-10 lg:px-16 lg:py-28">
      <div class="mx-auto grid max-w-[1440px] gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
        <h2 class="font-display max-w-3xl text-balance text-4xl font-semibold leading-[1.05] text-marfil sm:text-6xl">Cuéntanos qué parte de tu operación quieres hacer más clara.</h2>
        <div>
          <a class="btn btn--primary" href="/#hablemos"><i aria-hidden="true"></i>Hablemos</a>
          <p class="mt-3 text-sm leading-6 text-gris-tecnico">Sin compromiso.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
