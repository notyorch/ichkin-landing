---
interface Props {
  className?: string;
  label?: string;
  variant?: 'dark' | 'light';
}

const { className = '', label = 'Ichkin', variant = 'dark' } = Astro.props;
---
<svg class={`orbit-mark orbit-mark--${variant} ${className}`} width="108" height="108" viewBox="0 0 100 100" role="img" aria-label={label}>
  <circle class="orbit-cream" cx="50" cy="50" r="38" fill="none" stroke-width="9" stroke-linecap="round" stroke-dasharray="66.55 238.76" transform="rotate(186 50 50)" />
  <circle class="orbit-teal" cx="50" cy="50" r="38" fill="none" stroke-width="14" stroke-linecap="round" stroke-dasharray="139.3 238.76" transform="rotate(-16.35 50 50)" />
  <circle class="nucleus" cx="50" cy="50" r="14" />
</svg>
